@page "/Metodo-inversa"
@rendermode InteractiveServer
@using TeamPitagorasProyecto.Services
@inject MetodoInversaServices MetodoInversaService
@inject NavigationManager Nav

<PageTitle>LineMath - Método de la Inversa</PageTitle>

<div class="linemath-page">
    <header class="linemath-topbar">
        <a href="/" class="brand-link">
            <span class="brand-mark">x</span>
            <span class="brand-name">LineMath</span>
        </a>
    </header>

    <main class="linemath-container">
        <div class="title-row">
            <div class="title-left">
                <button type="button" class="back-btn" @onclick="GoBack" aria-label="Volver">
                    <span>‹</span>
                </button>
                <h1 class="page-title">Metodo de la Inversa</h1>
                <button type="button" class="help-btn" @onclick="ToggleHelp" title="Información del método">?</button>
            </div>

            <button type="button" class="solve-btn" @onclick="SolveSystem">
                Resolver ecuación
            </button>
        </div>

        @if (showHelp)
        {
            <div class="info-banner">
                El método de la inversa resuelve sistemas lineales AX = b calculando A⁻¹ mediante Gauss-Jordan y multiplicando X = A⁻¹b, siempre que det(A) ≠ 0.
            </div>
        }

        <section class="step-block">
            <div class="step-label">1. Selecciona el número de variables:</div>
            <div class="size-selector">
                @foreach (var size in AvailableSizes)
                {
                    <button type="button"
                            class="size-btn @(variableCount == size ? "active" : "")"
                            @onclick="() => ChangeSize(size)">
                        @size
                    </button>
                }
            </div>
        </section>

        <section class="step-block">
            <div class="step-label">2. Ingresa la matriz del coeficiente [A] y el vector de resultado [b]:</div>

            <div class="headers-grid">
                <div class="matrix-header-title">Matriz de Coeficiente [A]</div>
                <div class="vector-header-title">Vector b (terminos independientes)</div>
            </div>

            <div class="system-workspace">
                <div class="matrix-box">
                    <div class="var-columns" style="grid-template-columns: repeat(@variableCount, 76px);">
                        @for (int j = 0; j < variableCount; j++)
                        {
                            <div class="var-label">@GetVariableName(j)</div>
                        }
                    </div>

                    <div class="matrix-grid" style="grid-template-columns: repeat(@variableCount, 76px);">
                        @for (int i = 0; i < variableCount; i++)
                        {
                            int row = i;
                            for (int j = 0; j < variableCount; j++)
                            {
                                int col = j;
                                <input type="number"
                                       step="any"
                                       class="cell-input"
                                       value="@FormatInput(matrixA[row, col])"
                                       @onchange="@(e => OnMatrixInput(row, col, e.Value?.ToString()))" />
                            }
                        }
                    </div>
                </div>

                <div class="equals-sign">=</div>

                <div class="vector-box">
                    @for (int i = 0; i < variableCount; i++)
                    {
                        int row = i;
                        <input type="number"
                               step="any"
                               class="cell-input vector-input"
                               value="@FormatInput(vectorB[row])"
                               @onchange="@(e => OnVectorInput(row, e.Value?.ToString()))" />
                    }
                </div>
            </div>
        </section>

        <section class="result-section">
            <div class="result-title">Resultado</div>

            <div class="result-bar">
                <div class="result-pills">
                    @for (int i = 0; i < variableCount; i++)
                    {
                        string varName = GetVariableName(i);
                        string valText = GetSolutionDisplay(i);
                        <span class="result-pill">@varName = @valText</span>
                        @if (i < variableCount - 1)
                        {
                            <span class="pill-divider">|</span>
                        }
                    }
                </div>

                <button type="button" class="procedure-toggle" @onclick="ToggleProcedure">
                    <span>Ver procedimiento</span>
                    <span class="chevron @(showProcedure ? "open" : "")">⌄</span>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-box">@errorMessage</div>
            }

            @if (showProcedure && lastResult is not null && lastResult.Steps.Count > 0)
            {
                <div class="procedure-panel">
                    @foreach (var step in lastResult.Steps)
                    {
                        <pre class="step-line">@step</pre>
                    }
                </div>
            }
        </section>
    </main>
</div>

