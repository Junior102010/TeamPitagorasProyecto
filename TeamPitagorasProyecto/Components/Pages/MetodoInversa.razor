@code {
    private static readonly int[] AvailableSizes = [2, 3, 4, 5];
    private static readonly string[] VariableLabels = ["X", "Y", "Z", "W", "V"];

    private int variableCount = 3;
    private double[,] matrixA = new double[3, 3];
    private double[] vectorB = new double[3];
    private InverseMethodResult? lastResult;
    private string? errorMessage;
    private bool showProcedure;
    private bool showHelp;

    protected override void OnInitialized()
    {
        InitializeSystem(3);
    }

    private void ChangeSize(int newSize)
    {
        variableCount = newSize;
        InitializeSystem(newSize);
    }

    private void InitializeSystem(int n)
    {
        matrixA = new double[n, n];
        vectorB = new double[n];
        lastResult = null;
        errorMessage = null;
        showProcedure = false;
    }

    private string GetVariableName(int index)
    {
        return index < VariableLabels.Length ? VariableLabels[index] : $"X{index + 1}";
    }

    private string FormatInput(double value)
    {
        return value == 0 ? string.Empty : value.ToString("G");
    }

    private void OnMatrixInput(int row, int col, string? raw)
    {
        matrixA[row, col] = ParseDouble(raw);
    }

    private void OnVectorInput(int row, string? raw)
    {
        vectorB[row] = ParseDouble(raw);
    }

    private double ParseDouble(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return 0;

        if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out var val))
            return val;

        if (double.TryParse(raw.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out val))
            return val;

        return 0;
    }

    private void SolveSystem()
    {
        errorMessage = null;
        var result = MetodoInversaService.Solve(matrixA, vectorB);
        lastResult = result;

        if (!result.Success)
        {
            errorMessage = result.ErrorMessage;
        }
    }

    private string GetSolutionDisplay(int index)
    {
        if (lastResult is null || !lastResult.Success || index >= lastResult.Solution.Length)
            return "?";

        return lastResult.Solution[index].ToString("G6");
    }

    private void ToggleProcedure()
    {
        showProcedure = !showProcedure;
    }

    private void ToggleHelp()
    {
        showHelp = !showHelp;
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
